{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GlideLink",
  "version": "1.0.0",
  "identifier": "io.glidelink.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GlideLink",
        "width": 1040,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "theme": "Light",
        "backgroundColor": [242, 242, 247, 255]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "shortDescription": "One mouse, multiple computers",
    "longDescription": "A low-latency software KVM. Move your mouse across the edge of one screen to control another computer over the local network.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
